# ---------------------------------------------------------------------------
# ServiceNow connection (used by servicenow_client.py, exposed as MCP-style tools)
# ---------------------------------------------------------------------------
SERVICENOW_INSTANCE_URL=https://dev330388.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=RJw$3Bnq4jU%

# ---------------------------------------------------------------------------
# AWS Bedrock (LLM + Embeddings)
# ---------------------------------------------------------------------------
AWS_BEARER_TOKEN_BEDROCK=
AWS_DEFAULT_REGION=us-east-1
BEDROCK_TEXT_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBED_DIM=1024

# ---------------------------------------------------------------------------
# FAISS / RAG settings
# ---------------------------------------------------------------------------
FAISS_INDEX_DIR=data
FAISS_INDEX_NAME=closed_incidents
TOP_K_MATCHES=2

# ---------------------------------------------------------------------------
# SAPOM_completed bridge (sapom_bridge.py / action_plan/) — optional, only
# used for the 3 scenarios both apps share a mock console for. Defaults
# already match SAPOM_completed's own defaults; only override if it runs on
# a different host/port or its mock OAuth demo credentials were changed.
# ---------------------------------------------------------------------------
SAPOM_BASE_URL=http://127.0.0.1:4000

# ---------------------------------------------------------------------------
# Guardrail: rate limiting (per-client sliding window on /api/resolve)
# ---------------------------------------------------------------------------
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Flask
# ---------------------------------------------------------------------------
FLASK_SECRET_KEY=change-me-in-production
FLASK_DEBUG=True
FLASK_PORT=5000
